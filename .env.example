# ============================================================
# OrbitAI — variáveis de ambiente
# ============================================================

# --- Frontend (frontend/js/config.js) ---
# Encontre em: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Edge Function (supabase secrets set ...) ---
# Chave do provedor de IA. Recomendado: OpenRouter (https://openrouter.ai/keys)
# — uma chave dá acesso a dezenas de modelos, incluindo os ":free".
AI_API_KEY=sk-or-xxxxxxxx

# Opcionais:
# AI_BASE_URL=https://openrouter.ai/api/v1     # qualquer endpoint OpenAI-compatible (Groq, Together, OpenAI…)
# AI_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# APP_URL=https://seu-dominio.com
